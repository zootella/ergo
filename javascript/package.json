{
  "name": "@zootella/ergo",
  "version": "0.3.0",
  "description": "Simple helper functions, the same in JavaScript, Python, Rust, and Go.",
  "type": "module",
  "exports": {
    ".": "./ergo.js"
  },
  "files": [
    "ergo.js"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "fix": "cd .. && oxlint --fix --quiet && dprint fmt",
    "lint": "cd .. && oxlint",
    "test": "(cd .. && dprint check && oxlint --deny-warnings) && vitest run",
    "fuzz": "vitest run -t fuzz --silent=false"
  },
  "homepage": "https://zootella.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zootella/ergo.git",
    "directory": "javascript"
  },
  "keywords": [
    "helpers",
    "ergonomic",
    "isomorphic",
    "size",
    "time",
    "tag",
    "base32",
    "base62",
    "hash",
    "sha256",
    "blake3"
  ],
  "author": "zootella",
  "license": "MIT",
  "devDependencies": {
    "dprint": "0.64.3",
    "oxlint": "1.93.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
