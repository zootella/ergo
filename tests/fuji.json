  {"function":"hashStripeOverlap","input":[[0,1],[[0,1]]],"output":[[0,1]],"note":"one byte over one byte: X over X is X"},
  {"function":"hashStripeOverlap","input":[[0,1],[[1,2]]],"output":[],"note":"single touching, a miss: X over .X is nothing"},
  {"function":"hashStripeOverlap","input":[[1,2],[[0,1]]],"output":[],"note":"and the other way: .X over X is nothing"},
  {"function":"hashStripeOverlap","input":[[0,2],[[2,4]]],"output":[],"note":"double touching: XX over ..XX is nothing"},
  {"function":"hashStripeOverlap","input":[[2,4],[[0,2]]],"output":[],"note":"and the other way: ..XX over XX is nothing"},
  {"function":"hashStripeOverlap","input":[[0,2],[[3,5]]],"output":[],"note":"a gap between: XX over ...XX is nothing"},
  {"function":"hashStripeOverlap","input":[[3,5],[[0,2]]],"output":[],"note":"and the other way: ...XX over XX is nothing"},
  {"function":"hashStripeOverlap","input":[[0,1],[[0,2]]],"output":[[0,1]],"note":"a hit: X over XX is X"},
  {"function":"hashStripeOverlap","input":[[1,2],[[0,2]]],"output":[[1,2]],"note":"a hit at the second byte: .X over XX is .X"},
  {"function":"hashStripeOverlap","input":[[0,2],[[0,1]]],"output":[[0,1]],"note":"a hit, the background shorter: XX over X is X"},
  {"function":"hashStripeOverlap","input":[[0,2],[[1,2]]],"output":[[1,2]],"note":"and offset: XX over .X is .X"},
  {"function":"hashStripeOverlap","input":[[0,2],[[1,3]]],"output":[[1,2]],"note":"a simple overlap: XX over .XX is .X"},
  {"function":"hashStripeOverlap","input":[[1,3],[[0,2]]],"output":[[1,2]],"note":"and the other way: .XX over XX is .X"},
  {"function":"hashStripeOverlap","input":[[1,4],[[0,3]]],"output":[[1,3]],"note":"longer: .XXX over XXX is .XX"},
  {"function":"hashStripeOverlap","input":[[0,3],[[1,4]]],"output":[[1,3]],"note":"and the other way: XXX over .XXX is .XX"},
  {"function":"hashStripeOverlap","input":[[1,7],[[0,1],[2,4],[5,8]]],"output":[[2,4],[5,7]],"note":"one foreground over several background stripes: .XXXXXX over X.XX.XXX is ..XX.XX"},
  {"function":"hashStripeOverlap","input":[[2,5],[[2,5]]],"output":[[2,5]],"note":"exactly the same: ..XXX over ..XXX is ..XXX"},
  {"function":"hashStripeOverlap","input":[[3,7],[[2,4],[6,8]]],"output":[[3,4],[6,7]],"note":"the foreground cutting into two: ...XXXX over ..XX..XX is ...X..X"},
  {"function":"hashStripeOverlap","input":[[2,3],[[0,2]]],"output":[],"note":"past the background, a miss: ..X over XX is nothing"},
